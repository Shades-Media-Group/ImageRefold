{
  "name": "imagerefold",
  "version": "0.2.0",
  "private": true,
  "description": "Compress, convert and export images from Figma, and bring images back in already optimised. A free, open-source Figma plugin.",
  "license": "MIT",
  "author": "Shades Media Group (https://shades.md)",
  "homepage": "https://imagerefold.shades.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shades-Media-Group/ImageRefold.git"
  },
  "bugs": "https://github.com/Shades-Media-Group/ImageRefold/issues",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/figma-plugin/tsconfig.main.json",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "brand": "node scripts/brand.mjs",
    "assets": "node scripts/assets.mjs",
    "dev:site": "yarn --cwd apps/site dev",
    "build:site": "yarn --cwd apps/site build",
    "deploy:site": "yarn --cwd apps/site deploy",
    "verify": "yarn typecheck && yarn lint && yarn test && yarn build && yarn build:site",
    "format": "prettier --write .",
    "release": "node scripts/release.mjs",
    "build": "yarn --cwd apps/figma-plugin build",
    "dev:plugin": "yarn --cwd apps/figma-plugin dev",
    "dev:harness": "vite --port 4318 --strictPort",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "keywords": [
    "figma",
    "figma-plugin",
    "image-compression",
    "webp",
    "avif",
    "jpeg",
    "png",
    "export"
  ],
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.141.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "fflate": "^0.8.3",
    "preact": "^10",
    "shades-gradient": "https://github.com/Shades-Media-Group/gradient/releases/download/v0.2.0/shades-gradient-0.2.0.tgz"
  }
}
