{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "apps/figma-plugin/src/ui",
    "apps/figma-plugin/src/shared",
    "apps/site/src",
    "apps/site/vite.config.ts",
    "apps/site/pages.ts",
    "*.config.ts",
    "apps/site/worker.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
